<Window x:Class="FlagInjectorWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Flag Browser"
        Icon="Assets/FlagBrowser.ico"
        Width="1080"
        Height="700"
        MinWidth="940"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#080B12">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            ResizeBorderThickness="8"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="Bg" Color="#080B12"/>
        <SolidColorBrush x:Key="Panel" Color="#0E1420"/>
        <SolidColorBrush x:Key="Panel2" Color="#121B2A"/>
        <SolidColorBrush x:Key="Panel3" Color="#172235"/>
        <SolidColorBrush x:Key="Border" Color="#25354F"/>
        <SolidColorBrush x:Key="Text" Color="#EEF4FF"/>
        <SolidColorBrush x:Key="Muted" Color="#91A1BA"/>
        <SolidColorBrush x:Key="Accent" Color="#3B82F6"/>
        <SolidColorBrush x:Key="Accent2" Color="#60A5FA"/>
        <SolidColorBrush x:Key="Green" Color="#22C55E"/>
        <SolidColorBrush x:Key="Red" Color="#EF4444"/>
        <SolidColorBrush x:Key="Amber" Color="#F59E0B"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <Style TargetType="Border" x:Key="Card">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Panel2}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="CaretBrush" Value="{StaticResource Accent2}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource Panel2}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Panel3}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#20304A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1A2740"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value=".45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollBarLineButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Thumb"
                                Background="#2E4262"
                                CornerRadius="5"
                                Margin="2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Thumb" Property="Background" Value="#3B82F6"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Thumb" Property="Background" Value="#60A5FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Background" Value="#0B111C"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Root" Width="10" Background="#0B111C">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollBarLineButton}" Command="ScrollBar.PageUpCommand"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollBarLineButton}" Command="ScrollBar.PageDownCommand"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="Root" Property="Width" Value="Auto"/>
                                <Setter TargetName="Root" Property="Height" Value="10"/>
                                <Setter TargetName="PART_Track" Property="Orientation" Value="Horizontal"/>
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListView">
            <Setter Property="Background" Value="{StaticResource Panel2}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>

        <Style x:Key="RoundedListItem" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="4,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Row"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                CornerRadius="8"
                                Padding="8,5">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#142238"/>
                                <Setter TargetName="Row" Property="BorderBrush" Value="Transparent"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#163B74"/>
                                <Setter TargetName="Row" Property="BorderBrush" Value="Transparent"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GridListItem" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="3,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Row"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="0">
                            <GridViewRowPresenter Margin="8,5"
                                                  Content="{TemplateBinding Content}"
                                                  Columns="{Binding Path=View.Columns, RelativeSource={RelativeSource AncestorType=ListView}}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#17253A"/>
                                <Setter TargetName="Row" Property="BorderBrush" Value="#2F4567"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#1D4ED8"/>
                                <Setter TargetName="Row" Property="BorderBrush" Value="#60A5FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="#111B2B"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border x:Name="HeaderBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="#17253A"/>
                                <Setter TargetName="HeaderBorder" Property="BorderBrush" Value="#2F4567"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="#1D2D47"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#24344E" BorderThickness="1" Background="{StaticResource Bg}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="104"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#0B111C" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Border Width="22" Height="22" CornerRadius="6" Background="{StaticResource Accent}">
                            <TextBlock Text="F" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                        </Border>
                        <TextBlock Text="Flag Browser" FontSize="14" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Text="WPF preview" Foreground="{StaticResource Muted}" Margin="10,1,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="-" Width="46" Background="Transparent" BorderThickness="0" Click="Minimize_Click"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button Content="x" Width="46" Background="Transparent" BorderThickness="0" Click="Close_Click"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="12,10,12,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Padding="12,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" Grid.ColumnSpan="4" Margin="0,0,0,4">
                            <TextBlock Text="Offset Source" FontSize="14" FontWeight="SemiBold"/>
                            <Border Background="#0F2B57" CornerRadius="12" Padding="8,3" Margin="10,0,0,0">
                                <TextBlock Text="12,923 offsets" Foreground="#BFDBFE" FontSize="12"/>
                            </Border>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="URL 1" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,10,8,0"/>
                        <TextBox x:Name="Url1Box" Grid.Row="1" Grid.Column="1" Text="https://imtheo.lol/Offsets/FFlags.cs" Margin="0,10,10,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="URL 2" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,10,8,0"/>
                        <TextBox x:Name="Url2Box" Grid.Row="1" Grid.Column="3" Text="https://npdrlaufeimrkvdnjijl.supabase.co/functions/v1/get-offsets" Margin="0,10,0,0"/>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="90"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Load" Background="{StaticResource Accent}" Height="30" Click="LoadOffsets_Click"/>
                    <Button Grid.Column="2" Content="Update" Height="30" Click="LoadOffsets_Click"/>
                    <Button Grid.Column="4" Content="Settings" Height="30" Click="Settings_Click"/>
                </Grid>
            </Grid>

            <Grid Grid.Row="2" Margin="12,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="305"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Available Flags" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="1" Text="Search and stage new flags" Foreground="{StaticResource Muted}" Margin="0,1,0,8"/>
                        <TextBox x:Name="AvailableSearchBox" Grid.Row="2" Text="" Foreground="{StaticResource Text}" Margin="0,0,0,8" TextChanged="AvailableSearch_TextChanged"/>
                        <ListView x:Name="AvailableList" Grid.Row="3" ItemsSource="{Binding AvailableFlags}" ItemContainerStyle="{StaticResource RoundedListItem}" SelectionChanged="AvailableList_SelectionChanged" MouseDoubleClick="AvailableList_MouseDoubleClick">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Grid Grid.Row="4" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="72"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="AddValueBox" Text=""/>
                            <Button Grid.Column="1" Content="Add" Background="{StaticResource Accent}" Margin="6,0,0,0" Click="AddSelected_Click"/>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="104"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Modified Flags" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="Values, defaults, hotkeys, and active state" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Grid Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="62"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="62"/>
                                    <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="96"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Save" Height="32" Click="SaveProfile_Click"/>
                            <Button Grid.Column="2" Content="Load" Height="32" Click="LoadProfile_Click"/>
                            <Button Grid.Column="4" Content="Export" Height="32" Click="ExportJson_Click"/>
                            <Button Grid.Column="6" Content="Import" Height="32" Click="ImportJson_Click"/>
                            <Button Grid.Column="8" Content="Apply [F8]" Background="{StaticResource Green}" Height="32" Click="ApplyAll_Click"/>
                        </Grid>
                        </Grid>

                        <TextBox x:Name="ModifiedSearchBox" Grid.Row="1" Text="" Foreground="{StaticResource Text}" Margin="0,10,0,8" TextChanged="ModifiedSearch_TextChanged"/>

                        <ListView x:Name="ModifiedList" Grid.Row="2" ItemsSource="{Binding ModifiedFlags}" ItemContainerStyle="{StaticResource GridListItem}" SelectionChanged="ModifiedList_SelectionChanged">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Flag" Width="220" DisplayMemberBinding="{Binding Name}"/>
                                    <GridViewColumn Header="Value" Width="82" DisplayMemberBinding="{Binding Value}"/>
                                    <GridViewColumn Header="Type" Width="58" DisplayMemberBinding="{Binding Type}"/>
                                    <GridViewColumn Header="Enabled" Width="68" DisplayMemberBinding="{Binding Enabled}"/>
                                    <GridViewColumn Header="Default" Width="74" DisplayMemberBinding="{Binding DefaultValue}"/>
                                    <GridViewColumn Header="Hotkey" Width="82" DisplayMemberBinding="{Binding Hotkey}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <Border Grid.Row="3" Background="{StaticResource Panel2}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Margin="0,8,0,0" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="76"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="76"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="78"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="UpdateValueBox" Grid.Column="0" Text=""/>
                                    <Button Grid.Column="2" Content="Update" Background="{StaticResource Accent}" Click="UpdateSelected_Click"/>
                                    <Button Grid.Column="4" Content="On/Off" Click="ToggleSelected_Click"/>
                                    <Button Grid.Column="6" Content="Remove" Background="{StaticResource Red}" Click="RemoveSelected_Click"/>
                                </Grid>

                                <Grid Grid.Row="1" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="58"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="68"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="92"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="62"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Default" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox x:Name="DefaultValueBox" Grid.Column="1" Text=""/>
                                    <Button Grid.Column="3" Content="Set" Click="SetDefault_Click"/>
                                    <Button Grid.Column="5" Content="Reset" Click="ResetDefault_Click"/>
                                    <TextBlock Grid.Column="7" Text="Hotkey" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox x:Name="HotkeyBox" Grid.Column="8" Text="" IsReadOnly="True" GotFocus="HotkeyBox_GotFocus" LostFocus="HotkeyBox_LostFocus" PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
                                    <Button Grid.Column="10" Content="Clear" Click="ClearHotkey_Click"/>
                                </Grid>

                                <Border Grid.Column="1" Grid.RowSpan="2" Background="#071226" CornerRadius="8" Padding="12,8">
                                    <StackPanel>
                                        <TextBlock Text="Roblox" Foreground="{StaticResource Muted}"/>
                                        <TextBlock x:Name="RobloxStateText" Text="Not attached" Foreground="{StaticResource Red}" FontSize="18" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="RobloxPidText" Text="PID -" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="3" Background="#0B111C" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
                <Grid Margin="16,0">
                    <TextBlock x:Name="DefaultsStatusText" Text="defaults: not loaded" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" Text="Ready" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Text}"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
